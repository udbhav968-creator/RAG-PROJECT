{
  "annotations": {
    "list": []
  },
  "title": "Industrial RAG v9.0 System Telemetry Dashboard",
  "panels": [
    {
      "id": 1,
      "title": "RAG Query Throughput (QPS)",
      "type": "timeseries",
      "targets": [{ "expr": "rate(rag_queries_total[1m])" }]
    },
    {
      "id": 2,
      "title": "P95 Latency (ms)",
      "type": "gauge",
      "targets": [{ "expr": "histogram_quantile(0.95, rate(rag_latency_ms_bucket[5m]))" }]
    },
    {
      "id": 3,
      "title": "Faithfulness Score Distribution",
      "type": "stat",
      "targets": [{ "expr": "rag_average_faithfulness_score" }]
    }
  ]
}
